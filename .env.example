# Copy to .env and fill in. .env is git-ignored.
GROQ_API_KEY=gsk_your_key_here
# Optional overrides
WARRANT_PLANNER_MODEL=openai/gpt-oss-20b
WARRANT_CONTRACT_MODEL=openai/gpt-oss-120b
WARRANT_AUDITOR_MODEL=openai/gpt-oss-120b
WARRANT_AUDITOR_USE_LLM=1
# Real payments in Stripe TEST mode (see docs/integrations/PAYMENTS.md). Must start with sk_test_ or rk_test_; live keys are refused. Empty = simulated bank.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_CURRENCY=usd
# Real Slack demo workspace (optional; without it a simulated workspace is used). See docs/integrations/SLACK.md
SLACK_BOT_TOKEN=
# Optional: channels the bot may post to, comma separated, e.g. general,warrant-demo
SLACK_ALLOWED_CHANNELS=

# Real Gmail (dedicated demo account only; see docs/integrations/GMAIL.md). Leave unset for the simulated inbox.
# GMAIL_CREDENTIALS_FILE=secrets/gmail_credentials.json
# GMAIL_TOKEN_FILE=secrets/gmail_token.json
# Optional: only send to these recipient domains (comma separated)
# GMAIL_ALLOWED_DOMAINS=gmail.com

# Never stall on credit: if Groq runs out (daily limit), makes us wait, or is down, the planner
# switches to a local model served by Ollama (https://ollama.com, then: ollama pull qwen2.5:7b).
WARRANT_LOCAL_FALLBACK=1
WARRANT_LOCAL_BASE_URL=http://localhost:11434/v1
WARRANT_LOCAL_PLANNER_MODEL=qwen2.5:7b
# groq = Groq first, local on failure (default); local = always local (fully offline, no credit needed)
WARRANT_PLANNER_PROVIDER=groq
WARRANT_LLM_MAX_WAIT=8

# Open Bank Project SANDBOX bank (optional; see docs/integrations/OBP.md). Sandbox hosts only; empty = simulated bank.
OBP_BASE_URL=https://apisandbox.openbankproject.com
OBP_API_VERSION=v4.0.0
OBP_USERNAME=
OBP_PASSWORD=
OBP_CONSUMER_KEY=
OBP_BANK_ID=
OBP_ACCOUNT_ID=
OBP_CURRENCY=EUR
