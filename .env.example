# Copy to .env and fill in. .env is git-ignored.
GROQ_API_KEY=gsk_your_key_here
# Optional overrides
WARRANT_PLANNER_MODEL=openai/gpt-oss-20b
WARRANT_CONTRACT_MODEL=openai/gpt-oss-120b
WARRANT_AUDITOR_MODEL=openai/gpt-oss-120b
WARRANT_AUDITOR_USE_LLM=1

# Real Gmail (dedicated demo account only; see docs/integrations/GMAIL.md). Leave unset for the simulated inbox.
# GMAIL_CREDENTIALS_FILE=secrets/gmail_credentials.json
# GMAIL_TOKEN_FILE=secrets/gmail_token.json
# Optional: only send to these recipient domains (comma separated)
# GMAIL_ALLOWED_DOMAINS=gmail.com
