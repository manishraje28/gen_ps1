# Copy to .env and fill in. .env is git-ignored.
GROQ_API_KEY=gsk_your_key_here
# Optional overrides
WARRANT_PLANNER_MODEL=openai/gpt-oss-20b
WARRANT_CONTRACT_MODEL=openai/gpt-oss-120b
WARRANT_AUDITOR_MODEL=openai/gpt-oss-120b
WARRANT_AUDITOR_USE_LLM=1
# Real Slack demo workspace (optional; without it a simulated workspace is used). See docs/integrations/SLACK.md
SLACK_BOT_TOKEN=
# Optional: channels the bot may post to, comma separated, e.g. general,warrant-demo
SLACK_ALLOWED_CHANNELS=
