# Copy to .env and fill in. .env is git-ignored.
GROQ_API_KEY=gsk_your_key_here
# Optional overrides
WARRANT_PLANNER_MODEL=openai/gpt-oss-20b
WARRANT_CONTRACT_MODEL=openai/gpt-oss-120b
WARRANT_AUDITOR_MODEL=openai/gpt-oss-120b
WARRANT_AUDITOR_USE_LLM=1
# Never stall on credit: if Groq runs out (daily limit), makes us wait, or is down, the planner
# switches to a local model served by Ollama (https://ollama.com, then: ollama pull qwen2.5:7b).
WARRANT_LOCAL_FALLBACK=1
WARRANT_LOCAL_BASE_URL=http://localhost:11434/v1
WARRANT_LOCAL_PLANNER_MODEL=qwen2.5:7b
# groq = Groq first, local on failure (default); local = always local (fully offline, no credit needed)
WARRANT_PLANNER_PROVIDER=groq
WARRANT_LLM_MAX_WAIT=8
